<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons use weights + scalable icons, so they grow when the widget is resized -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: name + status, power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <LinearLayout
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Tap the name to open the app -->
            <TextView
                android:id="@+id/w_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LG TV"
                android:textColor="@color/w_fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Tap the status to re-check if the TV is on -->
            <LinearLayout
                android:id="@+id/w_status_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/w_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_dot_unknown" />

                <TextView
                    android:id="@+id/w_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="1"
                    android:text="Tap to check"
                    android:textColor="@color/w_fg"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sleep timer: tap for 30 min, tap again to cancel -->
        <ImageButton
            android:id="@+id/w_sleep"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_btn_round"
            android:contentDescription="Sleep timer"
            android:src="@drawable/wi_sleep" />

        <!-- ON/OFF power switch: the track drawable moves the knob; one label shows at a time -->
        <FrameLayout
            android:id="@+id/w_power"
            android:layout_width="78dp"
            android:layout_height="40dp"
            android:background="@drawable/w_switch_off"
            android:contentDescription="TV power">

            <TextView
                android:id="@+id/w_power_on"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="ON"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_power_off"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:paddingEnd="10dp"
                android:text="OFF"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Body: volume | d-pad | back/home. A scrim on top dims it when the TV is off. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageButton
                android:id="@+id/w_volup"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Volume up"
                android:scaleType="fitCenter"
                android:src="@drawable/wi_plus" />

            <ImageButton
                android:id="@+id/w_mute"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.8"
                android:background="@null"
                android:contentDescription="Mute"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wi_mute" />

            <ImageButton
                android:id="@+id/w_voldown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Volume down"
                android:scaleType="fitCenter"
                android:src="@drawable/wi_minus" />
        </LinearLayout>

        <!-- 3x3 grid: arrows on the edges, OK in the middle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/w_up"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="Up"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_up" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/w_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="Left"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_left" />

                <FrameLayout
                    android:id="@+id/w_ok"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:contentDescription="OK">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:duplicateParentState="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/wi_ok" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoSizeMaxTextSize="32sp"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeTextType="uniform"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:maxLines="1"
                        android:padding="14dp"
                        android:text="OK"
                        android:textColor="@color/w_ok_text"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/w_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="Right"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/w_down"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="Down"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wi_down" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:orientation="vertical"
            android:padding="3dp">

            <ImageButton
                android:id="@+id/w_back"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Back"
                android:scaleType="fitCenter"
                android:src="@drawable/wi_back" />

            <ImageButton
                android:id="@+id/w_home"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Home"
                android:scaleType="fitCenter"
                android:src="@drawable/wi_home" />
        </LinearLayout>
    </LinearLayout>

        <ImageView
            android:id="@+id/w_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_scrim"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
