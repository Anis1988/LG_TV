<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FF3FC8E6" android:endColor="#FF8A5CFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="#FF5EE7FF" android:centerColor="#FF8B7BFF" android:endColor="#FFFF6BD5" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                    <stroke android:width="1dp" android:color="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>