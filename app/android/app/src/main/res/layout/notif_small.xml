<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-screen mini remote (collapsed): the most-used buttons in one row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="52dp"
    android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/n_voldown_s" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@null" android:padding="3dp" android:scaleType="fitCenter"
            android:contentDescription="Volume down" android:src="@drawable/wi_minus" />
        <ImageButton android:id="@+id/n_volup_s" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@null" android:padding="3dp" android:scaleType="fitCenter"
            android:contentDescription="Volume up" android:src="@drawable/wi_plus" />
        <ImageButton android:id="@+id/n_back_s" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@null" android:padding="3dp" android:scaleType="fitCenter"
            android:contentDescription="Back" android:src="@drawable/wi_back" />
        <FrameLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1">
            <FrameLayout android:id="@+id/n_ok_s" android:layout_width="44dp" android:layout_gravity="center" android:layout_height="44dp" android:contentDescription="OK">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:duplicateParentState="true" android:scaleType="fitCenter" android:src="@drawable/wi_ok" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:duplicateParentState="true" android:gravity="center" android:text="OK" android:textColor="@color/w_ok_text" android:textSize="15sp" android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
        <ImageButton android:id="@+id/n_home_s" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@null" android:padding="3dp" android:scaleType="fitCenter"
            android:contentDescription="Home" android:src="@drawable/wi_home" />
</LinearLayout>